#!/usr/bin/env python3
"""community-backend - relay from a COCOON worker to the operator's own open model.

A COCOON worker forwards inference to 127.0.0.1:8000 (forward_requests_to). This relay listens there and passes each
request to any OpenAI-compatible server the operator already runs: Ollama, llama.cpp server, LM Studio, vLLM, SGLang.
That lets anyone with a laptop or a GPU box serve a real model to a COCOON testnet network without building the
confidential-VM image.

    scripts/community-backend --upstream http://127.0.0.1:11434/v1 --upstream-model qwen3:8b --model Qwen/Qwen3-8B

  --model           name announced to the network (must match the worker's MODEL_NAME)
  --upstream        base URL of the operator's OpenAI-compatible server (ending in /v1)
  --upstream-model  model name at the upstream (defaults to --model)
  --upstream-key    optional bearer key for the upstream (or env UPSTREAM_KEY)

Behaviour:
- the model name is rewritten both ways, so clients always see the announced name;
- `usage` is guaranteed: streams ask the upstream for it and fall back to an estimate, so token accounting and
  payments on the worker side always have numbers;
- request bodies over 4 MB are refused; upstream redirects are not followed; only http/https upstreams.

Trust note: this mode runs WITHOUT a TEE. The operator of a community worker can read the prompts it serves.
Networks built on it must say so to their users (see COMMUNITY.md). Stdlib only.
"""
import argparse
import http.client
import json
import os
import sys
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

MAX_BODY = 4 * 1024 * 1024
CFG = {'model': 'Qwen/Qwen3-8B', 'upstream': 'http://127.0.0.1:11434/v1', 'upstream_model': None,
       'upstream_key': None, 'timeout': 300.0}


def ntokens(text: str) -> int:
    return max(1, (len(text) + 3) // 4)


def prompt_text(body: dict) -> str:
    parts = []
    for m in body.get('messages', []) or []:
        c = m.get('content')
        if isinstance(c, str):
            parts.append(c)
        elif isinstance(c, list):
            parts += [p.get('text', '') for p in c if isinstance(p, dict)]
    return '\n'.join(parts) if parts else str(body.get('prompt', ''))


def upstream_parts():
    u = urlsplit(CFG['upstream'])
    if u.scheme not in ('http', 'https') or not u.hostname:
        raise ValueError('upstream must be an http(s) URL')
    port = u.port or (443 if u.scheme == 'https' else 80)
    return u.scheme, u.hostname, port, u.path.rstrip('/')


def open_upstream(method: str, path: str, body: bytes | None):
    scheme, host, port, base = upstream_parts()
    cls = http.client.HTTPSConnection if scheme == 'https' else http.client.HTTPConnection
    conn = cls(host, port, timeout=CFG['timeout'])
    headers = {'Content-Type': 'application/json', 'Accept': 'application/json, text/event-stream'}
    if CFG['upstream_key']:
        headers['Authorization'] = 'Bearer ' + CFG['upstream_key']
    conn.request(method, base + path, body=body, headers=headers)
    return conn, conn.getresponse()


def to_upstream(body: dict) -> dict:
    b = dict(body)
    b['model'] = CFG['upstream_model'] or CFG['model']
    return b


def rename(obj: dict) -> dict:
    if isinstance(obj, dict) and 'model' in obj:
        obj['model'] = CFG['model']
    return obj


class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, fmt, *args):
        print('[relay] ' + fmt % args, flush=True)

    def _json(self, code: int, obj: dict):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _error(self, code: int, msg: str):
        self._json(code, {'error': {'message': msg, 'type': 'community_backend'}})

    def do_GET(self):
        if self.path.startswith('/health'):
            try:
                conn, r = open_upstream('GET', '/models', None)
                r.read()
                conn.close()
                ok = r.status < 500
            except Exception as e:  # noqa: BLE001
                return self._json(503, {'status': 'upstream_down', 'detail': type(e).__name__})
            return self._json(200 if ok else 503, {'status': 'ok' if ok else 'upstream_error', 'model': CFG['model']})
        if self.path.startswith('/v1/models'):
            return self._json(200, {'object': 'list', 'data': [
                {'id': CFG['model'], 'object': 'model', 'owned_by': 'community'}]})
        self._error(404, 'not found')

    def do_POST(self):
        n = int(self.headers.get('Content-Length') or 0)
        if n > MAX_BODY:
            return self._error(413, 'request too large')
        try:
            body = json.loads(self.rfile.read(n) or b'{}')
            assert isinstance(body, dict)
        except Exception:  # noqa: BLE001
            return self._error(400, 'invalid json')
        if self.path.startswith('/v1/chat/completions'):
            return self.relay('/chat/completions', body, prompt_text(body))
        if self.path.startswith('/v1/completions'):
            return self.relay('/completions', body, str(body.get('prompt', '')))
        self._error(404, 'not found')

    def relay(self, path: str, body: dict, ptext: str):
        stream = bool(body.get('stream'))
        want_usage = bool((body.get('stream_options') or {}).get('include_usage'))
        up = to_upstream(body)
        if stream:
            up['stream_options'] = dict(up.get('stream_options') or {}, include_usage=True)
        try:
            conn, r = open_upstream('POST', path, json.dumps(up).encode())
        except Exception as e:  # noqa: BLE001
            return self._error(502, f'upstream unreachable: {type(e).__name__}')
        try:
            if r.status >= 300:
                detail = r.read(2000).decode('utf-8', 'replace')
                return self._error(502 if r.status >= 500 or r.status in (301, 302, 307, 308) else r.status,
                                   f'upstream http {r.status}: {detail[:300]}')
            if not stream:
                return self.plain(r, ptext)
            return self.streamed(r, ptext, want_usage)
        finally:
            conn.close()

    def plain(self, r, ptext: str):
        try:
            obj = json.loads(r.read())
        except Exception:  # noqa: BLE001
            return self._error(502, 'upstream returned non-json')
        rename(obj)
        if not obj.get('usage'):
            out = ''.join((c.get('message') or {}).get('content') or c.get('text') or ''
                          for c in obj.get('choices') or [])
            p, c = ntokens(ptext), ntokens(out)
            obj['usage'] = {'prompt_tokens': p, 'completion_tokens': c, 'total_tokens': p + c}
        self._json(200, obj)

    def streamed(self, r, ptext: str, want_usage: bool):
        self.send_response(200)
        self.send_header('Content-Type', 'text/event-stream')
        self.send_header('Cache-Control', 'no-cache')
        self.send_header('Connection', 'close')
        self.end_headers()
        out, usage, last = [], None, None

        def send(obj):
            self.wfile.write(b'data: ' + json.dumps(obj).encode() + b'\n\n')
            self.wfile.flush()

        for raw in r:
            line = raw.decode('utf-8', 'replace').strip()
            if not line.startswith('data:'):
                continue
            data = line[5:].strip()
            if data == '[DONE]':
                break
            try:
                obj = rename(json.loads(data))
            except Exception:  # noqa: BLE001
                continue
            last = obj
            if obj.get('usage'):
                usage = obj['usage']
            for ch in obj.get('choices') or []:
                d = ch.get('delta') or {}
                out.append(d.get('content') or ch.get('text') or '')
            if obj.get('choices'):
                if not want_usage:
                    obj.pop('usage', None)
                send(obj)
        if want_usage:
            if not usage:
                p, c = ntokens(ptext), ntokens(''.join(out))
                usage = {'prompt_tokens': p, 'completion_tokens': c, 'total_tokens': p + c}
            base = {k: (last or {}).get(k) for k in ('id', 'object', 'created')}
            base.setdefault('id', 'chatcmpl-' + uuid.uuid4().hex[:24])
            send(dict(base, id=base['id'] or 'chatcmpl-' + uuid.uuid4().hex[:24], object='chat.completion.chunk',
                      created=base['created'] or int(time.time()), model=CFG['model'], choices=[], usage=usage))
        self.wfile.write(b'data: [DONE]\n\n')
        self.wfile.flush()
        self.close_connection = True


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('--host', default='127.0.0.1')
    ap.add_argument('--port', type=int, default=8000)
    ap.add_argument('--model', default=os.environ.get('MODEL', CFG['model']))
    ap.add_argument('--upstream', default=os.environ.get('UPSTREAM_URL', CFG['upstream']))
    ap.add_argument('--upstream-model', default=os.environ.get('UPSTREAM_MODEL'))
    ap.add_argument('--upstream-key', default=os.environ.get('UPSTREAM_KEY'))
    ap.add_argument('--timeout', type=float, default=float(os.environ.get('UPSTREAM_TIMEOUT', '300')))
    a = ap.parse_args()
    CFG.update(model=a.model, upstream=a.upstream.rstrip('/'), upstream_model=a.upstream_model,
               upstream_key=a.upstream_key, timeout=a.timeout)
    try:
        upstream_parts()
    except ValueError as e:
        sys.exit(f'ERROR: {e}')
    print(f'community-backend on {a.host}:{a.port}: {CFG["model"]} -> {CFG["upstream"]} '
          f'({CFG["upstream_model"] or CFG["model"]})', flush=True)
    ThreadingHTTPServer((a.host, a.port), Handler).serve_forever()


if __name__ == '__main__':
    main()
